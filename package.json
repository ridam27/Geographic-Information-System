{
  "name": "geographic-information-system",
  "version": "1.0.0",
  "private": true,
  "description": "Root installer for all GIS sub-projects. `npm i` here installs every frontend, backend, and the Construction Python backend in one shot.",
  "scripts": {
    "postinstall": "node scripts/install-all.js",
    "install-all": "node scripts/install-all.js",
    "restore-envs": "node scripts/restore-envs.js",
    "start": "npm --prefix \"./main application\" run start"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mqtt": "^5.16.0",
    "mysql2": "^3.24.4",
    "redis": "^6.2.1",
    "ws": "^8.22.0"
  }
}
